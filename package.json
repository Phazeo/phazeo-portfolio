{
  "name": "phazeo-portfolio-profiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#kit": "./src/kit/index.ts",
    "#kit/*": "./src/kit/*"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "dev:guest-example": "VITE_GUEST_CSP_EXAMPLE=1 vite",
    "dev:directory-demo": "VITE_DIRECTORY_DEMO=45 vite",
    "build": "tsc -b && node tools/checks/check-registry.ts && node tools/checks/check-profiles.ts && vite build && node tools/build/write-headers.ts",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -b",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:registry": "node tools/checks/check-registry.ts",
    "check:profiles": "node tools/checks/check-profiles.ts",
    "check:imports": "node tools/checks/check-import-boundaries.ts",
    "check:headers": "node tools/build/write-headers.ts --check",
    "test": "node --test tests/unit/*.test.ts",
    "test:ownership": "node --test tests/unit/profile-ownership.test.ts",
    "test:imports": "node --test tests/unit/import-boundaries.test.ts",
    "test:scope": "node --test tests/unit/changed-scope.test.ts",
    "test:directory": "node --test tests/unit/directory-query.test.ts",
    "test:directory-contrast": "node --test tests/unit/directory-contrast.test.ts",
    "test:theme-provider": "node --test tests/unit/theme-provider.test.ts",
    "test:headers-merge": "node --test tests/unit/headers-merge.test.ts",
    "test:email-text": "node --test tests/unit/email-text.test.ts",
    "test:profiles": "node --test tests/unit/check-profiles.test.ts",
    "test:public-boundary": "node --test tests/unit/public-boundary.test.ts",
    "guard:tree": "sh tools/guard/check-leaks.sh --tree",
    "guard:staged": "sh tools/guard/check-leaks.sh --staged",
    "prove:csp": "node tests/prove/prove-csp.ts",
    "quality": "pnpm check && pnpm typecheck && pnpm check:registry && pnpm check:profiles && pnpm check:imports && pnpm test:ownership && pnpm test:profiles && pnpm test:imports && pnpm test:scope && pnpm test:directory && pnpm test:directory-contrast && pnpm test:theme-provider && pnpm test:headers-merge && pnpm test:email-text && pnpm test:public-boundary",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
