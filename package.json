{
  "name": "phazeo-portfolio-profiles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-registry.mjs && vite build && node scripts/write-headers.mjs",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:registry": "node scripts/check-registry.mjs",
    "check:headers": "node scripts/write-headers.mjs --check",
    "test:ownership": "node scripts/test-profile-ownership.mjs",
    "prove:csp": "node scripts/prove-csp.mjs",
    "quality": "pnpm check && pnpm typecheck && pnpm check:registry && pnpm test:ownership",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
