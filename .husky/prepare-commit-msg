#!/usr/bin/env sh
# Strip AI-only attribution Cursor/Claude/Copilot inject (forum pattern 2026).
# Human Co-authored-by lines are left alone. prepare-commit-msg survives --no-verify.

msgfile="$1"
[ -z "$msgfile" ] || [ ! -f "$msgfile" ] && exit 0

tmp=$(mktemp)
grep -viE \
  -e '^Co-authored-by:.*(cursor|cursoragent|copilot|chatgpt|claude|anthropic|gemini)' \
  -e '^Made-with:\s*(cursor|claude|copilot|chatgpt)' \
  -e '^Generated-by:\s*(cursor|claude|copilot|chatgpt)' \
  -e '^Claude-Session:' \
  -e 'cursoragent@cursor\.com' \
  -e 'noreply@anthropic\.com' \
  "$msgfile" > "$tmp" && mv "$tmp" "$msgfile"
rm -f "$tmp"
exit 0
